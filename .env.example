# =============================================================================
# Vehicle Management System - Environment Variables Configuration
# Copy this file to .env before starting the services
# =============================================================================

# --- MySQL Configuration ---
MYSQL_ROOT_PASSWORD=rootpassword
DB_USERNAME=vms_user
DB_PASSWORD=vms_password
DB_HOST=mysql
DB_PORT=3306

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8080

# --- JWT & Security Placeholders (to be configured in authentication stage) ---
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_placeholder

# --- Email Service Configuration ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=placeholder_email@example.com
MAIL_PASSWORD=placeholder_app_password
# Display name of the product as sender (e.g., Hệ thống Quản lý Phương tiện VMS)
MAIL_PRODUCT_NAME=Hệ thống Quản lý Phương tiện VMS
# Optional default recipient for automated notifications (leave empty to use MAIL_USERNAME)
NOTIFICATION_RECIPIENT_EMAIL=placeholder_email@example.com
